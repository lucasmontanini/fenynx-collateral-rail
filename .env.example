# Rede de teste.
XRPL_WSS=wss://s.devnet.rippletest.net:51233
LEDGER_MODE=devnet

# Seeds de teste geradas por scripts/00-setup.ts. Nunca commitar.
SEED_EMISSOR_BRL=
SEED_FENYNX=
SEED_AGENTE_GARANTIA=
SEED_INVESTIDOR=
SEED_TOMADOR=
SEED_FORMADOR_MERCADO=
SEED_TOKENIZADORA=

# Login do portal. Hash no formato sal:hash com scrypt. Nunca commitar a senha.
AUTH_EMAIL=
AUTH_SENHA_HASH=
AUTH_SEGREDO=

# Integracao com a API da Fenynx. Sem estas variaveis a integracao fica desligada.
FENYNX_API_URL=
FENYNX_API_KEY=
# Segredo que gera o codigo do cliente a partir do documento.
PRIVACIDADE_SEGREDO=
# Chave AES 256 em hex (64 caracteres) para cifrar dado pessoal em repouso.
PRIVACIDADE_CHAVE=
